# Copy this file to .env (or .env.local) in the frontend/ folder.
# CRA reads REACT_APP_* variables at build time.

# Backend URL — only needed if you change the default port or deploy remotely.
# The dev proxy in package.json already forwards to http://localhost:8000,
# so this variable is only required for production builds.
REACT_APP_API_URL=http://localhost:8000
DANGEROUSLY_DISABLE_HOST_CHECK=true