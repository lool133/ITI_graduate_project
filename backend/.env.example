# Copy this file to .env and fill in the values.

# ── Ollama ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_with_a_new_key_locally
GEMINI_MODEL=gemini-3.6-flash

# ── Paths (override only if you moved the notebook artifacts) ─────────────────
# Path to pipeline_config.json produced by the notebook.
# Default: <project_root>/artifacts/pipeline_config.json
# PIPELINE_CONFIG=../artifacts/pipeline_config.json

# Path to the FAISS index folder produced by the notebook export cell.
# Default: <project_root>/artifacts/faiss_index
# FAISS_DIR=../artifacts/faiss_index
# Path to the Chroma vector store folder produced by the notebook export cell.
# Default: <project_root>/backend/data/vector_store
# VECTOR_STORE=./data/vector_store
